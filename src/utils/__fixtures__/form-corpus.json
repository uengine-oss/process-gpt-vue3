ield name=\"deliverable_item\" alias=\"납품물 설명\" type=\"text\" disabled=\"false\" readonly=\"false\" v-model=\"item['deliverable_item']\"></text-field>      </div><div class=\"col-sm-4\">        <text-field name=\"deliverable_due\" alias=\"납기일\" type=\"date\" disabled=\"false\" readonly=\"false\" v-model=\"item['deliverable_due']\"></text-field>      </div></div></row-layout></div></row-layout>  </section><section>      <row-layout name=\"attachments\" alias=\"첨부\" is_multidata_mode=\"false\" v-model=\"formValues\" v-slot=\"slotProps\"><div class=\"row\"><div class=\"col-sm-12\">        <file-field name=\"proposal_attachment\" alias=\"첨부 파일\" disabled=\"false\" readonly=\"false\" v-model=\"slotProps.modelValue['proposal_attachment']\"></file-field>      </div></div></row-layout>  </section><section>      <row-layout name=\"proposal_validation\" alias=\"검증\" is_multidata_mode=\"false\" v-model=\"formValues\" v-slot=\"slotProps\"><div class=\"row\"><div class=\"col-sm-12\">        <code-field name=\"validateProposalForm\" alias=\"폼 검증\" event_type=\"validate\" watch_name=\"\" v-model=\"codeInfos['validateProposalForm']\">\nvar title = this.formValues['proposal_title'];\nvar date = this.formValues['proposal_date'];<br>var client = this.formValues['client_name'];<br>var email = this.formValues['contact_email'];<br>if(!title || title.trim() === '') error = '제안서 제목은 필수입니다.';<br>if(!date || date.trim() === '') error = '제안일은 필수입니다.';<br>if(!client || client.trim() === '') error = '고객명은 필수입니다.';<br>if(!email || email.trim() === '') error = '담당자 이메일은 필수입니다.';<br></code-field>      </div></div></row-layout>  </section>"
 },
