 {
  "id": "course_registration_process_review_application_form",
  "shape": "code-field outside columns",
  "html": "<section>  <row-layout name=\"approval_area\" alias=\"승인영역\" is_multidata_mode=\"false\" v-model=\"formValues\" v-slot=\"slotProps\"><div class=\"row\"><div class=\"col-sm-12\">      <textarea-field name=\"grading_comment\" alias=\"답안 채점\" rows=\"4\" disabled=\"false\" readonly=\"false\" v-model=\"slotProps.modelValue['grading_comment']\"></textarea-field><radio-field name=\"approval_status\" alias=\"수강 승인 여부\" disabled=\"false\" readonly=\"false\" items=\"[{'approved':'승인'},{'rejected':'반려'}]\" is_dynamic_load=\"false\" dynamic_load_url=\"\" dynamic_load_key_json_path=\"\" dynamic_load_value_json_path=\"\" dynamic_load_url_name=\"\" dynamic_load_key_column=\"\" dynamic_load_value_column=\"\" dynamic_data_source=\"\" v-model=\"slotProps.modelValue['approval_status']\"></radio-field><textarea-field name=\"rejection_reason\" alias=\"반려 사유\" rows=\"3\" disabled=\"false\" readonly=\"false\" v-model=\"slotProps.modelValue['rejection_reason']\"></textarea-field>    </div><code-field name=\"showRejectionReason\" alias=\"반려 사유 표시\" event_type=\"watch\" watch_name=\"approval_status\">\r\nif(this.formValues['approval_status'] === 'rejected') {\r\n  // 반려 사유 입력란을 보이게 처리하는 로직은 실제 시스템에서 구현 필요<br>} else {  this.formValues['rejection_reason'] = '';}</code-field><code-field name=\"validateApprovalStatus\" alias=\"수강 승인 검증\" event_type=\"validate\" watch_name=\"\">if(this.formValues['approval_status'] === 'rejected' &amp;&amp; (!this.formValues['rejection_reason'] || this.formValues['rejection_reason'].trim() === '')) {  error = '반려된 경우 반려 사유를 반드시 입력해야 합니다.';}</code-field></div></row-layout></section>"
 },
