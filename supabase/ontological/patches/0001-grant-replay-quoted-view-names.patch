+/// Callers pass either a bare `schema.rel` or a name they already quoted
+/// (`og_data."Task"`, as the alias and type views are built). Quoting the second
+/// kind again yields `"og_data"."""Task"""`, the GRANT fails, and because an
+/// SPI error aborts the transaction the "logged, never fatal" failure takes the
+/// type creation down with it.
+fn quoted_once(name: &str) -> String {
+    if name.contains('"') {
+        name.to_string()
+    } else {
+        spiu::qname(name)
+    }
+}
