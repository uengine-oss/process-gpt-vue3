{
    "include": [
        "env.d.ts",
        "src/**/*",
        "src/**/*.vue",
        "public/plugins/keditor.js",
        "mobile/**/*",
        "mobile/**/*.vue"
    ],
    "compilerOptions": {
        "module": "esnext",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@mobile/*": [
                "./mobile/src/*"
            ]
        },
        "allowJs": true,
        "ignoreDeprecations": "5.0",
        "target": "ESNext",
        "moduleResolution": "Node",
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true
    }
}
