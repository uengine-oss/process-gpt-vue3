VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
VITE_PAL_MODE=false
# PAL 모드 시스템 관리 백엔드(playground-pi-system-backend) dev 프록시 대상 (기본 http://127.0.0.1:8000)
VITE_PI_SYSTEM_BACKEND_URL=
# 실행(Exec) 기능 플래그 — 순서도의 실행 버튼·실행 ID·Exec 뷰·/executable 명령.
# PAL 모드에서는 엔진 모드(VITE_MODE=uEngine)이면서 이 값이 false가 아닐 때만 노출된다. 미설정 시 ON.
VITE_FF_EXECUTION=
# AI 기능 마스터 플래그 — false 면 아래 세부 플래그와 무관하게 모든 AI 버튼/패널이 숨는다. 미설정 시 ON.
VITE_FF_AI=
# AI 세부 플래그 (마스터가 ON일 때만 개별 제어. 미설정 시 ON)
# COPILOT: 순서도 AI Copilot 패널·Blueprint/AN 스튜디오·AI BPMN 생성·Lane/PI Flag AI
VITE_FF_AI_COPILOT=
# DESIGNER: BPMN 속성 패널 인라인 생성 버튼(조건룰·cron·스크립트·API 등)·이름/ID/diff 자동 생성
VITE_FF_AI_DESIGNER=
# FORM: 워크아이템 폼 AI 예시 생성
VITE_FF_AI_FORM=
# 개발·데모 라우트(/design-system, e2e 3종, /instance-classifier-demo, /markdown-editor, /slide-editor, /present).
# 인증 게이트 밖 공개 라우트라 프로덕션 빌드에서는 기본 OFF. vite dev 서버에서는 항상 ON. true 로만 켤 수 있다.
VITE_FF_DEV_ROUTES=
SECRET_KEY=
